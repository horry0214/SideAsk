{
  "manifest_version": 3,
  "name": "SideAsk",
  "version": "0.2.5",
  "version_name": "0.2.5 MVP",
  "description": "不中断当前阅读主线的 AI 支线提问层。划词、解释、追问，再一键回到原文。",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["markdown.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/sideask-mark.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "SideAsk：问题走支线，思路留主线",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
