# 默认 Provider。浏览器内配置优先；这里用于 Gateway 的环境变量回退。
# 可用 ID 见 extension/provider-catalog.js，例如：
# minimax-cn / openai / anthropic / gemini / openrouter / deepseek / qwen-cn / ollama / openai-compatible
# 不填写时继续兼容 MINIMAX_REGION=cn/global。
SIDEASK_PROVIDER_ID=minimax-cn

# 除 MiniMax 与 Custom 兼容配置外，所有目录 Provider 都支持通用回退：
# SIDEASK_API_KEY=
# SIDEASK_MODEL=
# SIDEASK_BASE_URL=
# 也可用 PROVIDER_ID 派生的专用变量，例如 ANTHROPIC_API_KEY / ANTHROPIC_MODEL / ANTHROPIC_BASE_URL。

# 不要把真实 Key 提交到 GitHub。
# 中国区 Token Plan Key 通常以 sk-cp- 开头。
MINIMAX_API_KEY=your_minimax_token_plan_key_here
MINIMAX_MODEL=MiniMax-M2.7

# cn = 中国区 https://api.minimaxi.com/v1
# global = 国际区 https://api.minimax.io/v1
MINIMAX_REGION=cn

# 一般无需填写。只有需要手工覆盖时再取消注释：
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Custom OpenAI-compatible（仅当 SIDEASK_PROVIDER_ID=openai-compatible 时使用）
# OPENAI_COMPATIBLE_NAME=My Provider
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=your_local_key_here
# OPENAI_COMPATIBLE_MODEL=my-model
# OPENAI_COMPATIBLE_ENDPOINT=https://api.example.com/v1/chat/completions

PORT=8787
